# Normalize text files in the repository. Shell scripts must keep LF,
# otherwise a container started from a Windows checkout fails with
# "/bin/sh^M: bad interpreter".
* text=auto eol=lf

*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
*.xlsx binary
