# Copy to deploy/.env and change values if needed.

# Public API origin embedded into the frontend at build time.
# Leave empty when the frontend and API share one origin (recommended):
# nginx proxies /map, /data, /country, ... to the backend.
# Set an absolute URL only for a split deployment, e.g. https://api.example.com
VITE_API_URL=

# Backend address without scheme, as seen from the nginx container.
BACKEND_UPSTREAM=backend:8652

# Host interface and port that publish nginx.
# Use 127.0.0.1 when a host reverse proxy terminates TLS.
WEB_BIND=0.0.0.0
WEB_PORT=8080

# Host directories mounted into the backend. Relative to deploy/.
# For production releases: /srv/redroom/data/current
HOST_RUNTIME_DIR=../data/runtime
HOST_LOG_DIR=../logs

# Number of Uvicorn workers in the backend container.
WEB_CONCURRENCY=2

# Logging level for the backend.
REDROOM_LOG_LEVEL=INFO

# Extra allowed browser origins (comma-separated) for a split deployment.
# REDROOM_CORS_ORIGINS=https://example.com
